# Samjha environment. Copy to .env.local. Everything is optional: with no AI key Samjha runs on its built-in engine.

# --- AI (first one set wins; all free options work) ---
# Google AI Studio free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq free key: https://console.groq.com/keys
GROQ_API_KEY=
# Any OpenAI-compatible endpoint (OpenRouter, local Ollama at http://localhost:11434/v1, ...)
LLM_BASE_URL=
LLM_API_KEY=
# Claude API
ANTHROPIC_API_KEY=
# Override model names for the active provider (strong = grading/extraction/buddy, fast = intent + short replies)
SAMJHA_MODEL_STRONG=
SAMJHA_MODEL_FAST=
# Set to 1 to force the built-in offline engine even when a key is present
SAMJHA_OFFLINE=

# --- App ---
# Signs the session cookie and share/report links. Use a long random string in production.
SAMJHA_SECRET=change-me-to-a-long-random-string
# Public URL (used in nudge links, QR codes and the Chrome extension)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Where the local SQLite database lives (default ./.data)
SAMJHA_DATA_DIR=

# --- Premium voice (optional; browser voices are used otherwise) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# --- Nudges (optional; without keys nudges are recorded in the app's nudge log) ---
RESEND_API_KEY=
RESEND_FROM="Samjha <study@yourdomain.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Protects GET /api/cron/nudges (Vercel cron sends it as a Bearer token)
CRON_SECRET=

# --- Placement mode (optional; raises GitHub API rate limits for repo reading) ---
GITHUB_TOKEN=
